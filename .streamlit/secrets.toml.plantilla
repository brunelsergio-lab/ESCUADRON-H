# Copiar este archivo como: .streamlit/secrets.toml
# Nunca subir secrets.toml a GitHub ni compartirlo públicamente.

DATABASE_URL = "postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE?sslmode=require"

# Usar solo si necesita recuperar/admin inicial.
OWNER_ADMIN_ENABLED = "false"
OWNER_ADMIN_USER = "admin"
OWNER_ADMIN_PASSWORD = "CAMBIAR_ESTA_CLAVE"
OWNER_ADMIN_SOLO = "true"

# Formulario público de licencia.
PLAN_FORM_ENABLED = "true"
PLAN_FORM_TOKEN = "licencia2026"
